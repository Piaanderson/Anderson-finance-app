# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/currents

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
# WebAuthn / passkeys
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:3000
PASSKEY_RP_NAME=Currents
# Required only while creating the first owner; remove after setup.
PASSKEY_BOOTSTRAP_TOKEN=
# Local-only sign-in. The app refuses this setting in production.
AUTH_DEV_BYPASS=true

# Plaid Sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=https://example.test/api/plaid/webhook

# 32-byte key encoded as base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1
# During rotation, retain older versions until all rows are re-encrypted:
# TOKEN_ENCRYPTION_KEY_V1=
# TOKEN_ENCRYPTION_KEY_V2=

# Worker/operations
SYNC_POLL_MS=5000
LOG_LEVEL=info
CRON_SECRET=
